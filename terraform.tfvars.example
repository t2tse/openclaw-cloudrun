# ─────────────────────────────────────────────────────────────────────────────
# OpenClaw on Cloud Run -- Example Variables
# Copy this to terraform.tfvars and fill in your values.
#
# SECURITY: Never commit terraform.tfvars to version control.
#           Add it to .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Required
project_id = "my-gcp-project"

# Region & Zone
region = "us-west1"
zone   = "us-west1-c"

# Resource name prefix — distinguishes the current terraform stack from another stack in the same GCP project.
# All resource names become: run-openclaw-*, and the VPC is openclaw-run-vpc.
name_prefix  = "run"
network_name = "openclaw-run-vpc"

# Developers — each gets an isolated Cloud Run service, GCS workspace bucket, and service account
developers = {
  "alice" = { active = true }
  "bob"   = { active = true }
}

# OpenClaw
openclaw_version = "latest"
model_primary    = "litellm/gemini-3.1-pro-preview"
model_fallbacks  = "[\"litellm/gemini-3.1-flash-lite-preview\"]"

# Cloud Run execution environment — choose one:
#   "gen2" — MicroVM sandbox (seccomp syscall filtering + Sandbox2 Linux namespace isolation)
#             Recommended: best compatibility and isolation.
#   "gen1" — gVisor sandbox (user-space kernel, lower overhead)
#             Use when gen2 compatibility issues arise.
execution_environment = "gen2"

# Optional -- leave empty to auto-generate a 48-char hex token
# gateway_auth_token = ""

# Optional secrets (sensitive -- prefer TF_VAR_ env vars or Secret Manager injection)
# brave_api_key = ""

# Optional: Alerting
# alert_email = "you@example.com"

# ── Optional: Execution VMs ─────────────────────────────────────────────────
# Uncomment to add VMs for OS-native command execution.
# OS is auto-detected from the image name.

# exec_vms = {
#   "windows" = { os_image = "windows-cloud/windows-2022" }
#   "linux"   = { os_image = "debian-cloud/debian-12", machine_type = "e2-standard-2" }
# }
